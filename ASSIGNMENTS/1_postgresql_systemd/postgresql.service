[Unit]
Description=PostgreSQL in Docker container
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
ExecStartPre=-/usr/bin/docker rm -f postgresql
ExecStart=/usr/bin/docker run --rm --name postgresql \
  --env-file /etc/postgresql-docker/secrets.env \
  -e POSTGRES_USER=appuser -e POSTGRES_DB=appdb \
  -v /srv/postgresql/data:/var/lib/postgresql/data \
  -p 127.0.0.1:5432:5432 \
  devopfall2026/postgres:16
ExecStartPost=/usr/local/bin/postgresql-wait-ready.sh
TimeoutStartSec=90
ExecStop=/usr/bin/docker stop --time 60 postgresql
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

