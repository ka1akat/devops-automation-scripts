[Unit]
Description=GitLab Runner container
Requires=docker.service
After=docker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/docker start -a gitlab-runner
ExecStop=/usr/bin/docker stop -t 30 gitlab-runner
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
